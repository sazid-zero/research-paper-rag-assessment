# Application Settings
APP_NAME=Research Paper RAG Assistant
DEBUG=True
RELOAD=True
HOST=0.0.0.0
PORT=8000

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=research_papers

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Text Chunking
CHUNK_SIZE=512
CHUNK_OVERLAP=100
MIN_CHUNK_LENGTH=50

# RAG Settings
TOP_K=5
CONFIDENCE_THRESHOLD=0.5
SIMILARITY_THRESHOLD=0.3

# LLM Provider: ollama, deepseek, openai, or openrouter
LLM_PROVIDER=openrouter

# Ollama Configuration (if using ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# DeepSeek Configuration (if using deepseek)
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_API_URL=https://api.deepseek.com

# OpenAI Configuration (if using openai)
OPENAI_API_KEY=your_openai_api_key

# OpenRouter Configuration (if using openrouter) - FREE with $5 credit
OPENROUTER_API_KEY=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
OPENROUTER_API_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-chat

# Database
DATABASE_URL=sqlite:///./papers.db

# PDF Settings
MAX_PDF_SIZE_MB=50

# LLM Generation Settings
LLM_TIMEOUT=300
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=512
